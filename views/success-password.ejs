
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap CSS CDN -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi"
        crossorigin="anonymous"
    >

    <title>Password Reset Successful</title>

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #5a1a2d, #7a2942);
        }

        .success-card {
            max-width: 500px;
            width: 100%;
            background-color: #f8f1f3;
            border-radius: 24px;
        }

        .success-icon {
            width: 85px;
            height: 85px;
            background-color: #ead6dc;
            color: #6b2036;
            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            margin: 0 auto 25px;
            font-size: 40px;
        }

        .success-title {
            color: #3d1724;
        }

        .success-text {
            color: #6f5a62;
            line-height: 1.7;
        }

        .login-btn {
            background-color: #6b2036;
            border: none;
            border-radius: 12px;
            padding: 13px;
            font-weight: 600;
        }

        .login-btn:hover {
            background-color: #53182a;
        }
    </style>
</head>

<body>

    <div class="container min-vh-100 d-flex justify-content-center align-items-center">

        <div class="success-card shadow-lg text-center p-4 p-md-5">

            <!-- Success Icon -->
            <div class="success-icon">
                ✓
            </div>

            <!-- Title -->
            <h2 class="success-title fw-bold mb-3">
                Password Reset Successful
            </h2>

            <!-- Message -->
            <p class="success-text mb-4">
                Your password has been successfully changed.
                You can now log in using your new password.
            </p>

            <!-- Login Button -->
            <a
                href="/api/auth/login"
                class="btn login-btn text-white w-100">
                Go to Login
            </a>

        </div>

    </div>

</body>

</html>

