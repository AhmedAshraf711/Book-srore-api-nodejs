
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap CSS CDN -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
        integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi"
        crossorigin="anonymous"
    >

    <title>Reset Password</title>

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #5a1a2d, #7a2942);
        }

        .reset-card {
            max-width: 500px;
            width: 100%;
            background-color: #f8f1f3;
            border-radius: 24px;
        }

        .lock-icon {
            width: 80px;
            height: 80px;
            background-color: #ead6dc;
            color: #6b2036;
            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            margin: 0 auto 25px;
            font-size: 36px;
        }

        .reset-title {
            color: #3d1724;
        }

        .email-text {
            color: #6b2036;
            font-weight: 600;
            word-break: break-word;
        }

        .password-wrapper {
            position: relative;
        }

        .form-control {
            border: 1px solid #d8c2c9;
            border-radius: 12px;
            padding: 13px 50px 13px 15px;
            background-color: #fffafb;
        }

        .form-control:focus {
            border-color: #7a2942;
            box-shadow: 0 0 0 0.2rem rgba(122, 41, 66, 0.15);
        }

        .toggle-password {
            position: absolute;
            top: 50%;
            right: 15px;
            transform: translateY(-50%);

            border: none;
            background: transparent;

            color: #6b2036;
            font-size: 20px;

            cursor: pointer;
            padding: 0;
        }

        .toggle-password:hover {
            color: #53182a;
        }

        .reset-btn {
            background-color: #6b2036;
            border: none;
            border-radius: 12px;
            padding: 13px;
            font-weight: 600;
        }

        .reset-btn:hover {
            background-color: #53182a;
        }
    </style>
</head>

<body>

    <div class="container min-vh-100 d-flex justify-content-center align-items-center">

        <div class="reset-card shadow-lg p-4 p-md-5">

            <!-- Lock Icon -->
            <div class="lock-icon">
                🔐
            </div>

            <!-- Header -->
            <div class="text-center mb-4">

                <h2 class="reset-title fw-bold mb-2">
                    Reset Password
                </h2>

                <p class="text-secondary mb-1">
                    Create a new password for
                </p>

                <p class="email-text mb-0">
                    <%= email %>
                </p>

            </div>

            <!-- Reset Form -->
            <form action="" method="post">

                <div class="mb-4">

                    <label
                        class="form-label fw-semibold"
                        for="password">
                        New Password
                    </label>

                    <!-- Password Input -->
                    <div class="password-wrapper">

                        <input
                            class="form-control form-control-lg"
                            type="password"
                            id="password"
                            name="password"
                            placeholder="Enter your new password"
                            required
                        >

                        <button
                            type="button"
                            class="toggle-password"
                            id="togglePassword"
                            aria-label="Show password">
                            👁️
                        </button>

                    </div>

                    <div class="form-text mt-2">
                        Choose a strong password that you haven't used before.
                    </div>

                </div>

                <button
                    class="btn reset-btn text-white w-100"
                    type="submit">
                    Reset Password
                </button>

            </form>

        </div>

    </div>

    <!-- Show / Hide Password -->
    <script>
        const passwordInput = document.getElementById("password");
        const togglePassword = document.getElementById("togglePassword");

        togglePassword.addEventListener("click", function () {

            if (passwordInput.type === "password") {

                passwordInput.type = "text";
                togglePassword.textContent = "🙈";
                togglePassword.setAttribute("aria-label", "Hide password");

            } else {

                passwordInput.type = "password";
                togglePassword.textContent = "👁️";
                togglePassword.setAttribute("aria-label", "Show password");

            }

        });
    </script>

</body>

</html>

