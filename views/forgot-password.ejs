
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <!-- Bootstrap 5 -->
    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <title>Reset Password</title>

    <style>
        body {
            min-height: 100vh;
            background: linear-gradient(135deg, #5a1a2d, #7a2942);
        }

        .reset-card {
            background-color: #f8f1f3;
            border: none;
            border-radius: 24px;
            max-width: 460px;
            width: 100%;
        }

        .icon-box {
            width: 72px;
            height: 72px;
            background-color: #ead6dc;
            color: #6b2036;
            border-radius: 50%;

            display: flex;
            align-items: center;
            justify-content: center;

            margin: 0 auto 20px;
            font-size: 30px;
        }

        .form-control {
            border: 1px solid #d8c2c9;
            border-radius: 12px;
            padding: 13px 15px;
            background-color: #fffafb;
        }

        .form-control:focus {
            border-color: #7a2942;
            box-shadow: 0 0 0 0.2rem rgba(122, 41, 66, 0.15);
            background-color: #ffffff;
        }

        .reset-btn {
            background-color: #6b2036;
            border: none;
            border-radius: 12px;
            padding: 13px;
            font-weight: 600;
        }

        .reset-btn:hover {
            background-color: #53182a;
        }

        .back-link {
            color: #6b2036;
        }

        .back-link:hover {
            color: #451322;
        }
    </style>
</head>

<body>

    <div class="container min-vh-100 d-flex justify-content-center align-items-center">

        <div class="reset-card shadow-lg p-4 p-md-5">

            <!-- Lock Icon -->
            <div class="icon-box">
                🔐
            </div>

            <!-- Header -->
            <div class="text-center mb-4">

                <h2 class="fw-bold text-dark mb-2">
                    Reset Your Password
                </h2>

                <p class="text-secondary mb-0">
                    Don't worry! Enter your email address and
                    we'll send you a link to reset your password.
                </p>

            </div>

            <!-- Form -->
            <form action="/api/auth/forgot-password" method="post">

                <div class="mb-4">

                    <label
                        for="email"
                        class="form-label fw-semibold">
                        Email Address
                    </label>

                    <input
                        type="email"
                        class="form-control"
                        id="email"
                        name="email"
                        placeholder="Enter your email address"
                        required
                    >

                </div>

                <button
                    type="submit"
                    class="btn reset-btn text-white w-100">
                    Send Reset Link
                </button>

            </form>

        </div>

    </div>

</body>

</html>

